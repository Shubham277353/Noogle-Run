<body>
    <div>

        <button onclick="openModal('foldarModal')">+</button>

        <dialog id="foldarModal">
            <form action="/folder/new" method="post">
                <h1>Create Folder</h1>
                <input type="text" name="folderName" required>
                <button type="submit">Create</button>
                <button type="button" onclick="closeModal('foldarModal')">Cancel</button>
            </form>
        </dialog>
    </div>

    <hr>

    <div id="folders-container">
        <% folders.forEach((folder) => { %>
            <form id="renameForm" style="display: none;" action="/folder/<%= folder.id %>/rename" method="post">
                <input type="text" name="folderName" value="<%= folder.name %>">
                <button type="submit">Submit</button>
                <button id="cancelBtn" type="button">Cancel</button>
            </form>
            <a id="folderName" href="/folder/<%= folder.id %>"> <%= folder.name %> </a>
            <a id="deleteBtn" href="/folder/<%= folder.id %>/delete">Delete</a>
            <button id="renameBtn">Rename</button>
        <% }) %>
    </div>

    <script>
        function openModal(id){
            document.getElementById(id).showModal();
        }
        function closeModal(id){
            document.getElementById(id).close();
        }

        const renameBtn = document.getElementById("renameBtn");
        const deleteBtn = document.getElementById("deleteBtn");
        const form = document.getElementById("renameForm");
        const folderName = document.getElementById("folderName");
        const cancelBtn = document.getElementById("cancelBtn");
        renameBtn.addEventListener("click", () => {
            form.style.display = "";
            folderName.style.display = "none";
            deleteBtn.style.display = "none";
            cancelBtn.style.display = "";
            renameBtn.style.display = "none";
        });
        cancelBtn.addEventListener("click", () => {
            form.style.display = "none";
            folderName.style.display = "";
            deleteBtn.style.display = "";
            cancelBtn.style.display = "none";
        });
    </script>
</body>